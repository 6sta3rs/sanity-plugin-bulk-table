{
  "name": "sanity-plugin-bulk-table",
  "version": "2.0.0",
  "description": "A powerful table view plugin for Sanity Studio v4/v5/v6 with bulk actions, column selection, and document management capabilities",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "sanity-studio",
    "sanity-v6",
    "sanity-bulk-actions",
    "sanity-table-view",
    "sanity-document-management",
    "sanity-structure-tool"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0x6Star3s/sanity-plugin-bulk-table.git"
  },
  "homepage": "https://github.com/0x6Star3s/sanity-plugin-bulk-table#readme",
  "bugs": {
    "url": "https://github.com/0x6Star3s/sanity-plugin-bulk-table/issues"
  },
  "license": "MIT",
  "author": "0x6Star3s <pawel.stach81@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict",
    "dev": "run-s watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@sanity/icons": "^5",
    "@sanity/id-utils": "^1",
    "@sanity/ui": "^3"
  },
  "devDependencies": {
    "@sanity/cli": "^7",
    "@sanity/client": "^7.26",
    "@sanity/icons": "^5",
    "@sanity/pkg-utils": "^12",
    "@sanity/plugin-kit": "^10",
    "@sanity/ui": "^3",
    "@sanity/vision": "^6",
    "@types/node": "^22",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "@types/styled-components": "^5.1.34",
    "groq-js": "^2.0.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2",
    "react-dom": "^19.2",
    "rxjs": "^7.8.2",
    "sanity": "^6",
    "sanity-plugin-utils": "^1.6.7",
    "semantic-release": "^24.2.3",
    "styled-components": "^6.5",
    "typescript": "^5.9",
    "vitest": "^3"
  },
  "peerDependencies": {
    "react": "^19.2",
    "react-dom": "^19.2",
    "sanity": "^4 || ^5 || ^6",
    "styled-components": "^6.1"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "packageManager": "pnpm@9.15.1+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b583be4bfcf",
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "inlinedDependencies": {
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  }
}
